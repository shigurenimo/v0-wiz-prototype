{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "author": {
            "type": ["string", "null"]
          },
          "baseStatusPoint": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "baseStrengthPoint": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "baseDexterityPoint": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "baseIntelligencePoint": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "profile": {
            "type": "object",
            "properties": {
              "age": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "gender": {
                "type": "string"
              },
              "occupation": {
                "type": "string"
              },
              "description": {
                "type": "string"
              }
            },
            "required": ["age", "gender", "occupation", "description"],
            "additionalProperties": false
          },
          "personality": {
            "type": "object",
            "properties": {
              "trait": {
                "type": "string"
              },
              "tone": {
                "type": "string"
              },
              "coreValue": {
                "type": "string"
              },
              "contradiction": {
                "type": "string"
              }
            },
            "required": ["trait", "tone", "coreValue", "contradiction"],
            "additionalProperties": false
          },
          "backstory": {
            "type": "string"
          },
          "relationships": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "targetId": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                }
              },
              "required": ["targetId", "description"],
              "additionalProperties": false
            }
          },
          "exampleDialogues": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "id",
          "name",
          "author",
          "baseStatusPoint",
          "baseStrengthPoint",
          "baseDexterityPoint",
          "baseIntelligencePoint",
          "profile",
          "personality",
          "backstory",
          "relationships",
          "exampleDialogues"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": ["$schema", "items"],
  "additionalProperties": false
}
